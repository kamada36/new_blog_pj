# Supabaseのプロジェクトトップページ上部の「Connect」ボタンから取得する。
# アプリ実行時(Next.jsのサーバーレス関数)からはTransaction Pooler(6543番ポート)を使う。
# ?pgbouncer=true は必須(PgBouncerのトランザクションモードではprepared statementが使えないため)。
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Prisma Migrate/db seed用の直接接続(Session PoolerまたはDirect connection)。5432番ポートを使う。
# PgBouncerのトランザクションモードはマイグレーションに対応しないため、必ずこちらを使う。
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Session signing secret (HS256, 32+ random bytes recommended).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# Used to build absolute URLs (sitemap, OGP, canonical links).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional: overrides the seed script's default admin login.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# --- メディアアップロード先 (Cloudflare R2) ---
# 管理画面からのアップロード(カバー画像・プロフィール画像・メディアライブラリ等)は
# すべてこのR2バケットに保存される。Cloudflareダッシュボード > R2 > 該当バケット >
# 「設定」からAPIトークンを発行して取得する。
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
# バケットの公開URL。カスタムドメインを紐付けている場合はそのURL(例: https://media.resilient-cer.com)、
# 未設定ならR2の公開開発URL(https://pub-xxxx.r2.dev)を使う。
R2_PUBLIC_URL=""

# --- WordPress記事移行 (scripts/import-wordpress.ts / `npm run import:wordpress`) ---

# 移行元WordPressサイトのURL(末尾スラッシュなし)。
# 下書き・非公開記事もREST APIで取得するため、WP管理画面の
# 「ユーザー > プロフィール > アプリケーションパスワード」で発行した認証情報を使う。
WP_URL="https://old-site.example.com"
WP_USER="admin"
WP_APP_PASSWORD="xxxx xxxx xxxx xxxx xxxx xxxx"

# 画像実体の移行先(Cloudflare R2等)。本文・アイキャッチ中の旧WP画像URLはすべてこのドメインへ置換される。
NEW_MEDIA_BASE_URL="https://media.resilient-cer.com"

# 任意: 旧URLの検出ルールを上書きしたい場合のみ設定する。
# 省略時はそれぞれ「WP_URLのホスト名」「/wp-content/uploads」「なし(R2バケット直下に年フォルダを置く構成が前提)」が使われる。
# R2バケット側に"uploads"フォルダを作っている場合のみ NEW_MEDIA_PATH_PREFIX="/uploads" を指定する。
# WP_OLD_MEDIA_DOMAIN="old-site.example.com"
# WP_OLD_MEDIA_PATH_PREFIX="/wp-content/uploads"
# NEW_MEDIA_PATH_PREFIX=""

# 任意: WP REST APIの1ページあたり取得件数(デフォルト50)。
# WP_IMPORT_PER_PAGE=50

# 任意: trueにするとDBへ書き込まず、取得・変換結果のみをコンソールに表示する。
# WP_IMPORT_DRY_RUN=true

# --- SQLダンプからの移行 (scripts/import-wordpress-sql.ts / `npm run import:wordpress-sql`) ---
# WP REST APIの代わりに、mysqldump等でエクスポートしたSQLファイルを直接読み込んで移行する場合。
# WP_URL / WP_USER / WP_APP_PASSWORD は不要(WP_URLのみ、旧ドメイン判定に使うので任意で設定可)。

# 任意: SQLダンプファイルのパス(省略時は scripts/data/wp-export.sql)。
# このファイル自体はDB内容をそのまま含むため、Gitには絶対にコミットしない(.gitignore設定済み)。
# WP_SQL_FILE="scripts/data/wp-export.sql"

# --- AI記事生成 (/admin/generate) ・ AIリライト (/admin/rewrite) ---
# 管理画面からAIで記事を生成・リライトするための設定。どちらも「サーバー側だけ」で使う値なので、
# NEXT_PUBLIC_ を付けないこと(ブラウザへ露出させない)。
#
# ニュース取得はGoogleニュースのRSS(https://news.google.com/rss/search)を使うため、APIキーは不要。

# 【必須】Google AI Studio (https://aistudio.google.com/apikey) で発行するGemini APIキー。
# 構成案の生成(Google検索によるリサーチ)・アイキャッチ画像の生成・リライトの標準モデルに使う。
GEMINI_API_KEY=""

# 【任意】Anthropic Console (https://console.anthropic.com/) で発行するAPIキー。
# 本文執筆・リライトでClaudeモデルを選ぶ場合のみ必要。未設定でもGeminiモデルだけで動作する。
ANTHROPIC_API_KEY=""

# 【任意】アイキャッチ画像の生成に使うGeminiの画像モデル。未設定時は gemini-3.1-flash-image。
# GEMINI_IMAGE_MODEL="gemini-3.1-flash-image"

# 生成したアイキャッチ画像は、上の「メディアアップロード先 (Cloudflare R2)」(R2_*)へ保存され、
# メディアライブラリに登録される。画像生成を使う場合は R2_* がすべて設定されている必要がある。
# 生成した記事・リライト結果はこのブログのSupabase(DATABASE_URL)へ保存される(WordPressへは送信しない)。

# --- アクセス解析(Googleアナリティクス4) ---
# 現行サイトと同じ測定IDで計測を続ける。未設定でも G-WMC11VJDZN が使われる。空文字("")にすると計測しない。
# 計測するのは本番ドメイン(NEXT_PUBLIC_SITE_URL のホスト)で開かれたときだけ。仮のデプロイ先・ローカルでは送信されない。
# NEXT_PUBLIC_GA_ID="G-WMC11VJDZN"
