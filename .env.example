DATABASE_URL="file:./dev.db"

# Session signing secret (HS256, 32+ random bytes recommended).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# Used to build absolute URLs (sitemap, OGP, canonical links).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional: overrides the seed script's default admin login.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
