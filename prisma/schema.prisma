generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// 管理者（現状は単一管理者を想定）
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  bio          String    @default("")
  avatarUrl    String?
  snsX         String?
  snsThreads   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  articles     Article[]
}

// サイト全体の基本設定（シングルトン運用）
model SiteSetting {
  id              String @id @default(cuid())
  siteName        String @default("レジリエンサーCafe")
  tagline         String @default("YOUR RESILIENCE MATTERS!")
  footerCopyright String @default("レジリエンサーCafe")

  // ヘッダーのサイト名横ロゴとファビコン。未設定時はデフォルト(マグアイコン / app/favicon.ico)を使う
  headerLogoUrl String?
  faviconUrl    String?

  // スポンサーリンク(アフィリエイト広告)の埋め込みHTML。ASPが発行するコードをそのまま保存し、
  // 表示側で一切のリサイズ・加工をしない(規約上、改変不可のため)。
  sponsorSidebarEmbed        String @default("") // ウィジェット枠(正方形〜縦長長方形の広告を想定)
  sponsorSidebarCompactEmbed String @default("") // ウィジェット枠・目次上部(高さ60px程度の小型バナーを想定)
  sponsorFooterEmbed         String @default("") // フッター上部(横長バナー広告を想定)

  // トップページ見出し(ヒーローセクション)の画像
  heroBackgroundUrl         String? // 背景画像
  heroBackgroundMobileUrl   String? // 幅が狭い画面(1024px未満)用の縦長の背景画像。未設定時は heroBackgroundUrl を使う
  heroCharacterResilientUrl String? // キャラクター「レジサン」
  heroCharacterAikoUrl      String? // キャラクター「アイコ」

  // サイドバーウィジェット「サイトの住人」
  residentName      String  @default("アイコ")
  residentBio       String  @default("プログラミングを勉強中でエンジニアへの転職に憧れている。日々このサイト内でレジサンからITに関する様々な事を学んでいる。")
  residentAvatarUrl String? // 未設定時はデフォルトアイコンを表示
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String    @default("")
  iconUrl     String? // トップページのカテゴリーカード等で使うアイコン画像。未設定時はデフォルトアイコンを表示
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  articles    Article[]
}

// 記事本文中で [sc name="xxx"]コメント[/sc] の形式で呼び出す、
// キャラクター吹き出しコメントのプリセット(WordPress版Shortcoderの後継)。
model Shortcode {
  id          String   @id @default(cuid())
  name        String   @unique
  iconUrl     String
  position    String   @default("l") // "l" | "r"(吹き出しアイコンの左右位置)
  defaultTalk String   @default("コメント")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Tag {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now())
  articles  Article[]
}

model Article {
  id              String    @id @default(cuid())
  // WordPressからの移行元記事ID。手動作成記事はnull。
  // 移行スクリプト(scripts/import-wordpress.ts)がこのキーでupsertし、再実行しても重複を作らない。
  wpId            Int?      @unique
  title           String
  slug            String    @unique
  excerpt         String    @default("")
  contentMarkdown String
  coverImageUrl   String?
  status          String    @default("draft") // "draft" | "published" | "private"
  publishedAt     DateTime?
  viewCount       Int       @default(0)
  metaTitle       String    @default("")
  metaDescription String    @default("")
  metaKeywords    String    @default("")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  category   Category @relation(fields: [categoryId], references: [id])
  categoryId String

  author   User   @relation(fields: [authorId], references: [id])
  authorId String

  tags Tag[]
  views ArticleView[]

  // AIリライト実行前の本文バックアップ(未確定の間だけ存在する。「元に戻す」で復元する)
  rewriteBackup ArticleRewriteBackup?

  // 内部リンク提案(AIリライト)用の、記事の要約索引と、記事ごとの提案結果
  linkIndex      ArticleLinkIndex?
  linkSuggestion ArticleLinkSuggestion?

  @@index([status, publishedAt])
  @@index([categoryId])
}

// AIリライト(/admin/rewrite)の「元に戻す」用バックアップ。
// 記事ごとに1件だけ持ち、最初のリライト実行時にのみ作成する(連続リライトしても最初の原文を保つ)。
// 「この内容で確定」または「元に戻す」で削除される。
model ArticleRewriteBackup {
  articleId           String    @id
  originalContent     String
  originalStatus      String
  originalPublishedAt DateTime?
  createdAt           DateTime  @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
}

// AIリライトの実行履歴。記事を削除しても履歴が残るよう、articleIdは外部キーにせずタイトルも複製して持つ。
model ArticleRewriteLog {
  id           String   @id @default(cuid())
  articleId    String
  articleTitle String
  articleSlug  String   @default("")
  status       String // "success" | "failed" | "reverted"
  model        String   @default("")
  instruction  String   @default("")
  summary      String?
  errorMessage String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([articleId])
}

// 内部リンク提案用の記事索引。AIが作った「この記事は何を解説しているか」の要約とキーワード。
// タイトル・URL・公開状態は Article から常に最新を引くため、ここには持たない。
// リライトは記事の意味を変えないので、要約は一度作れば再生成しない(索引の作り直しは管理画面から)。
model ArticleLinkIndex {
  articleId    String   @id
  summary      String
  keywords     String[]
  summarizedAt DateTime @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
}

// 記事ごとの内部リンク候補(最大3件)。suggestions は [{ "articleId": "...", "reason": "..." }] の配列。
// 紹介先の記事が削除・非公開になった分は、表示時に取り除く。
model ArticleLinkSuggestion {
  articleId   String   @id
  suggestions Json
  computedAt  DateTime @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
}

// 記事の閲覧ログ（本日/週間/月間の集計、および重複アクセスの除外用）
model ArticleView {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  // IP+UAを一方向ハッシュ化した訪問者識別子（生IPは保存しない）
  visitorHash String @default("")

  article   Article @relation(fields: [articleId], references: [id])
  articleId String

  @@index([articleId, createdAt])
  @@index([articleId, visitorHash, createdAt])
}

// 固定ページ（プロフィール/サイト概要/プライバシーポリシー等）
model Page {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  contentMarkdown String
  metaTitle       String   @default("")
  metaDescription String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// メディアライブラリ(R2にアップロードした画像の管理)
model Media {
  id        String   @id @default(cuid())
  key       String   @unique // R2オブジェクトキー(削除時に使用)
  url       String // 公開URL
  filename  String // 表示用ファイル名(編集可能。アップロード時は元ファイル名)
  altText   String   @default("")
  mimeType  String
  size      Int // バイト数
  // 画像の使い方の分類(カテゴリーではなく用途)。
  // "article": 記事ごとに個別に使う画像(アイキャッチ・記事内メディア。デフォルト)
  // "setting": プロフィール画像やカテゴリーアイコンなど、サイト設定として標準的に使い回す画像
  usageType String   @default("article")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

// お問い合わせフォームの送信内容
model ContactMessage {
  id        String    @id @default(cuid())
  name      String
  email     String
  message   String
  createdAt DateTime  @default(now())
  readAt    DateTime?
}
