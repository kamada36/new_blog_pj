# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# local sqlite database
*.db
*.db-journal

# user-uploaded media (local filesystem storage)
/public/uploads/*
!/public/uploads/.gitkeep

# WordPress export dump(s) used by scripts/import-wordpress-sql.ts (contains raw DB data, never commit)
/scripts/data/

# 移植作業用の一時参照フォルダ（Git追跡せずローカルでのみ参照）
/reference-tools/